{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "worker.ts",
	"name": "mail",
	"minify": true,
	"compatibility_date": "2026-09-28",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"images": {
		"binding": "IMAGES"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mail","database_id": "699eddba-1b0b-41e4-90b7-b0871e4a1cff"
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "MAIL_HUB", "class_name": "MailHub" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["MailHub"] }],
	"ratelimits": [
		{
			"name": "CREATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 10, "period": 60 }
		},
		{
			"name": "AUTH_LIMITER",
			"namespace_id": "1003",
			"simple": { "limit": 10, "period": 60 }
		},
		{
			"name": "LOOKUP_LIMITER",
			"namespace_id": "1005",
			"simple": { "limit": 30, "period": 60 }
		}
	],
	"triggers": {
		"crons": ["0 * * * *"]
	},
	"workers_dev": true,
	"keep_vars": true
}
